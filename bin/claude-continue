#!/bin/bash
set -euo pipefail

usage() {
  echo "Usage: claude-continue [--model <model>] [--effort <level>] <handoff.md> [project-dir]"
  echo "Opens a WezTerm tab in project-dir (default: current directory) and starts Claude Code with the handoff as its first prompt."
  exit 1
}

FLAGS=()
while [[ "${1:-}" == --model || "${1:-}" == --effort ]]; do
  [[ $# -ge 2 ]] || usage
  FLAGS+=("$1" "$2")
  shift 2
done

[[ $# -ge 1 && -f "$1" ]] || usage
command -v wezterm >/dev/null || { echo "wezterm is not on PATH"; exit 1; }

HANDOFF="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"
PROJECT="$(cd "${2:-.}" && pwd)"
TITLE="$(basename "$HANDOFF" .md)"

# wezterm passes this session's CLAUDE* variables to the new tab, which turns off
# transcript saving there, so clear them before starting claude.
PANE_ID="$(wezterm cli spawn --cwd "$PROJECT" -- zsh -lic '
  unset -m "CLAUDE*"
  handoff=$1; shift
  claude "$@" "$(cat "$handoff")"
  exec zsh -l
' claude-continue "$HANDOFF" ${FLAGS[@]+"${FLAGS[@]}"})"
wezterm cli set-tab-title --pane-id "$PANE_ID" "$TITLE"
wezterm cli activate-pane --pane-id "$PANE_ID"

echo "Started Claude${FLAGS[*]:+ (${FLAGS[*]})} in a new tab (pane $PANE_ID) in $PROJECT with $HANDOFF"
