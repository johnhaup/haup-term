#!/usr/bin/env bash
# How long a Claude Code conversation has been idle, for its status line.
#   claude-idle hook                 Claude Code hook: Stop starts the clock; UserPromptSubmit and
#                                    PreToolUse clear it, because Claude is working again
#   claude-idle statusline [cmd...]  statusLine command: prints cmd's output (cmd gets the same
#                                    stdin) followed by "idle 12m" while the clock runs, in the
#                                    color of the WezTerm tab the session is in
#   claude-idle install [file]       Wire both into Claude Code's settings (default
#                                    ~/.claude/settings.json): the three hooks, and a statusLine
#                                    around the current one that refreshes every 5 seconds.
#                                    Safe to re-run; term-refresh runs it.
# The hook never fails or prints: a hook problem must not disturb the session.

install() {
  local settings="${1:-$HOME/.claude/settings.json}" self tmp
  self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/claude-idle"
  [[ -f "$settings" ]] || { mkdir -p "$(dirname "$settings")" && echo '{}' >"$settings"; } || return 1
  tmp=$(mktemp "${TMPDIR:-/tmp}/claude-idle.XXXXXX") || return 1
  if ! jq --arg self "$self" '
    ("\"" + $self + "\"") as $q
    | reduce ("Stop", "UserPromptSubmit", "PreToolUse") as $event (.;
        if any(.hooks[$event][]?.hooks[]?; (.command // "") | contains("/claude-idle")) then .
        else .hooks[$event] += [{hooks: [{type: "command", command: ($q + " hook"), async: true}]}]
        end)
    | (.statusLine.command // "") as $current
    | if $current | contains("/claude-idle") then .
      else .statusLine = (.statusLine // {}) + {type: "command", command: (
        if $current == "" then $q + " statusline"
        # Agent Deck wants its wrapper outermost and runs what follows "--"
        elif $current | test("agent-deck.* statusline-wrap$") then
          $current + " -- " + $q + " statusline " + $current
        else $q + " statusline sh -c " + ($current | @sh)
        end)}
      end
    | .statusLine.refreshInterval //= 5
  ' "$settings" >"$tmp"; then
    rm -f "$tmp"
    echo "claude-idle: could not read $settings as JSON" >&2
    return 1
  fi
  if cmp -s <(jq -S . "$settings") <(jq -S . "$tmp"); then
    echo "Claude idle time already wired"
  else
    # Write through the existing file so its permissions (or a symlink) stay as they are
    cat "$tmp" >"$settings" && echo "Claude idle time wired into $settings (new sessions pick up the hooks)"
  fi
  rm -f "$tmp"
}

if [[ "$1" == install ]]; then
  install "$2"
  exit
fi

dir="${XDG_CACHE_HOME:-$HOME/.cache}/claude-idle"
input=$(cat)
session=$(jq -r '.session_id // empty' <<<"$input" 2>/dev/null)
# The id becomes a file name, so accept only what a session id looks like
[[ "$session" =~ ^[A-Za-z0-9-]+$ ]] || session=""
stamp="$dir/$session"

# Same list and order as dracula.accents in config/wezterm.lua, which colors tab N with accent N mod 7
ACCENTS=(bd93f9 ff79c6 8be9fd 50fa7b ffb86c f1fa8c ff5555)

# ANSI color of the WezTerm tab this session's pane is in; nothing outside WezTerm
tab_color() {
  [[ -n "$WEZTERM_PANE" ]] || return
  local wez tab hex
  wez=$(command -v wezterm || echo /Applications/WezTerm.app/Contents/MacOS/wezterm)
  tab=$("$wez" cli list --format json 2>/dev/null |
    jq -r --argjson pane "$WEZTERM_PANE" '.[] | select(.pane_id == $pane) | .tab_id' 2>/dev/null)
  [[ "$tab" =~ ^[0-9]+$ ]] || return
  hex=${ACCENTS[tab % ${#ACCENTS[@]}]}
  printf '\033[38;2;%d;%d;%dm' "0x${hex:0:2}" "0x${hex:2:2}" "0x${hex:4:2}"
}

case "$1" in
  hook)
    [[ -n "$session" ]] || exit 0
    if [[ "$(jq -r '.hook_event_name // empty' <<<"$input" 2>/dev/null)" == "Stop" ]]; then
      mkdir -p "$dir" && touch "$stamp"
      find "$dir" -type f -mtime +30 -delete 2>/dev/null
    else
      rm -f "$stamp"
    fi
    exit 0
    ;;
  statusline)
    shift
    line=""
    if (($#)); then
      # The timer re-runs this every few seconds and cmd is the slow part, so reuse its last
      # output while the payload is the same apart from the running clocks in .cost
      cache="$dir/$session.base"
      key="$* $(jq -c 'del(.cost)' <<<"$input" 2>/dev/null)"
      if [[ -n "$session" && -f "$cache" && "$(head -n 1 "$cache")" == "$key" ]]; then
        line=$(tail -n +2 "$cache")
      else
        line=$("$@" <<<"$input")
        if [[ -n "$session" && -n "$line" ]] && mkdir -p "$dir" && tmp=$(mktemp "$dir/.base.XXXXXX"); then
          printf '%s\n%s\n' "$key" "$line" >"$tmp" && mv "$tmp" "$cache"
        fi
      fi
    fi
    if [[ -n "$session" && -f "$stamp" ]]; then
      since=$(stat -f %m "$stamp" 2>/dev/null || stat -c %Y "$stamp")
      s=$(($(date +%s) - since))
      if ((s < 60)); then
        idle="<1m"
      elif ((s < 3600)); then
        idle="$((s / 60))m"
      elif ((s < 86400)); then
        idle=$(printf '%dh %02dm' $((s / 3600)) $((s % 3600 / 60)))
      else
        idle="$((s / 86400))d $((s % 86400 / 3600))h"
      fi
      color=$(tab_color)
      line+="${line:+ | }${color}idle $idle${color:+$'\033[0m'}"
    fi
    printf '%s\n' "$line"
    ;;
esac
