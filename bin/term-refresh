#!/bin/bash
# Sets up a fresh machine with dev tools and shell config.
# Supports macOS (Homebrew) and Linux (apt, dnf, pacman).
# Idempotent — safe to run multiple times, skips anything already installed.

set -euo pipefail

# --- Pull latest changes ---
# Bash keeps running the copy of this script it already opened, so after a pull
# that changes anything, restart once to run the new version.
REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
if [[ -d "$REPO_DIR/.git" && -z "${TERM_REFRESH_PULLED:-}" ]]; then
  echo "Pulling latest haup-term..."
  before="$(git -C "$REPO_DIR" rev-parse HEAD)"
  # --no-rebase: pull.rebase refuses any uncommitted change; a fast-forward only stops for changed files it would touch
  if ! git -C "$REPO_DIR" pull --ff-only --no-rebase; then
    echo -e "\033[1;33m  Could not pull haup-term (see above). Continuing with the local copy.\033[0m"
    echo -e "\033[1;33m  Local changes: git -C $REPO_DIR status\033[0m"
  fi
  echo ""
  if [[ "$(git -C "$REPO_DIR" rev-parse HEAD)" != "$before" ]]; then
    TERM_REFRESH_PULLED=1 exec "$0" "$@"
  fi
fi

echo ""
echo '██╗  ██╗ █████╗ ██╗   ██╗██████╗        ████████╗███████╗██████╗ ███╗   ███╗'
echo '██║  ██║██╔══██╗██║   ██║██╔══██╗       ╚══██╔══╝██╔════╝██╔══██╗████╗ ████║'
echo '███████║███████║██║   ██║██████╔╝██████╗   ██║   █████╗  ██████╔╝██╔████╔██║'
echo '██╔══██║██╔══██║██║   ██║██╔═══╝ ╚═════╝   ██║   ██╔══╝  ██╔══██╗██║╚██╔╝██║'
echo '██║  ██║██║  ██║╚██████╔╝██║               ██║   ███████╗██║  ██║██║ ╚═╝ ██║'
echo '╚═╝  ╚═╝╚═╝  ╚═╝ ╚═════╝ ╚═╝               ╚═╝   ╚══════╝╚═╝  ╚═╝╚═╝     ╚═╝'
echo ""

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

info()  { echo -e "${CYAN}$1${NC}"; }
ok()    { echo -e "${GREEN}$1${NC}"; }
warn()  { echo -e "${YELLOW}$1${NC}"; }
fail()  { echo -e "${RED}$1${NC}"; }

check() {
  if command -v "$1" &>/dev/null; then
    ok "  ✓ $1 already installed"
    return 0
  fi
  return 1
}

# --- Detect OS and package manager ---
OS="$(uname -s)"
DISTRO=""
PKG=""

case "$OS" in
  Darwin)
    PKG="brew"
    ;;
  Linux)
    if [[ -f /etc/os-release ]]; then
      DISTRO="$(. /etc/os-release && echo "$ID")"
    fi
    # Prefer Homebrew when present (e.g. Bazzite/Fedora Atomic, where dnf can't install)
    if command -v brew &>/dev/null; then
      PKG="brew"
    elif command -v apt-get &>/dev/null; then
      PKG="apt"
    elif command -v dnf &>/dev/null; then
      PKG="dnf"
    elif command -v pacman &>/dev/null; then
      PKG="pacman"
    else
      fail "No supported package manager found (apt, dnf, pacman)."
      exit 1
    fi
    ;;
  *)
    fail "Unsupported OS: $OS"
    exit 1
    ;;
esac

# --- Detect shell rc file ---
if [[ -n "${ZSH_VERSION:-}" ]] || [[ "$SHELL" == */zsh ]]; then
  SHELL_RC="$HOME/.zshrc"
  SHELL_NAME="zsh"
elif [[ -n "${BASH_VERSION:-}" ]] || [[ "$SHELL" == */bash ]]; then
  SHELL_RC="$HOME/.bashrc"
  SHELL_NAME="bash"
else
  SHELL_RC="$HOME/.profile"
  SHELL_NAME="sh"
fi

# --- Helper: add a line to shell rc if not already present ---
rc_add() {
  local line="$1"
  if grep -qF "$line" "$SHELL_RC" 2>/dev/null; then
    ok "  ✓ $SHELL_RC already has: $line"
    return
  fi
  echo "$line" >> "$SHELL_RC"
  info "  Added to $SHELL_RC: $line"
}

# --- Helper: install a package ---
pkg_install() {
  local name="$1"
  # Some packages have different names across managers
  local brew_name="${2:-$name}"
  local apt_name="${3:-$name}"
  local dnf_name="${4:-$name}"
  local pacman_name="${5:-$name}"

  if check "$name"; then
    return
  fi

  info "  Installing $name..."
  case "$PKG" in
    brew)   brew install "$brew_name" ;;
    apt)    sudo apt-get install -y "$apt_name" ;;
    dnf)    sudo dnf install -y "$dnf_name" ;;
    pacman) sudo pacman -S --noconfirm "$pacman_name" ;;
  esac
}

echo -e "${CYAN}=== haup-term setup ($OS${DISTRO:+ / $DISTRO}) ===${NC}\n"

# ============================================================
# Package Manager
# ============================================================

if [[ "$OS" == "Darwin" ]]; then
  if ! check brew; then
    info "Installing Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    if [[ -f /opt/homebrew/bin/brew ]]; then
      eval "$(/opt/homebrew/bin/brew shellenv)"
    fi
  fi
elif [[ "$PKG" == "apt" ]]; then
  info "Updating apt package list..."
  sudo apt-get update -qq
fi

echo ""

# ============================================================
# CLI Tools
# ============================================================

info "Installing CLI tools..."

# Tools available in all package managers (with name overrides where needed)
#              command    brew        apt             dnf             pacman
pkg_install    "fzf"      "fzf"       "fzf"           "fzf"           "fzf"
pkg_install    "zoxide"   "zoxide"    "zoxide"        "zoxide"        "zoxide"
pkg_install    "lazygit"  "lazygit"   "lazygit"       "lazygit"       "lazygit"
pkg_install    "fd"       "fd"        "fd-find"       "fd-find"       "fd"
pkg_install    "bat"      "bat"       "bat"           "bat"           "bat"
pkg_install    "eza"      "eza"       "eza"           "eza"           "eza"
pkg_install    "yazi"     "yazi"      "yazi"          "yazi"          "yazi"
pkg_install    "htop"     "htop"      "htop"          "htop"          "htop"
pkg_install    "rg"       "ripgrep"   "ripgrep"       "ripgrep"       "ripgrep"
pkg_install    "jq"       "jq"        "jq"            "jq"            "jq"
pkg_install    "ccache"   "ccache"    "ccache"        "ccache"        "ccache"

echo ""

# ============================================================
# GitHub CLI + gh-dash + gh-enhance
# ============================================================

info "Installing GitHub CLI..."
pkg_install    "gh"       "gh"        "gh"            "gh"            "github-cli"

if command -v gh &>/dev/null; then
  if gh extension list 2>/dev/null | grep -q "dlvhdr/gh-dash"; then
    ok "  ✓ gh-dash already installed"
  else
    info "  Installing gh-dash extension..."
    gh extension install dlvhdr/gh-dash
  fi

  if gh extension list 2>/dev/null | grep -q "dlvhdr/gh-enhance"; then
    ok "  ✓ gh-enhance already installed"
  else
    info "  Installing gh-enhance extension..."
    gh extension install dlvhdr/gh-enhance
  fi
fi

echo ""

# ============================================================
# Posting (TUI API client)
# ============================================================

info "Installing Posting..."
if ! check posting; then
  if [[ "$PKG" == "brew" ]]; then
    brew install posting
  elif command -v pipx &>/dev/null; then
    pipx install posting
  elif command -v pip3 &>/dev/null; then
    pip3 install --user posting
  else
    warn "  Skipping posting — install pipx or pip3 first"
  fi
fi

echo ""

# ============================================================
# Starship prompt
# ============================================================

info "Installing Starship..."
if ! check starship; then
  if [[ "$PKG" == "brew" ]]; then
    brew install starship
  else
    curl -sS https://starship.rs/install.sh | sh -s -- -y
  fi
fi

echo ""

# ============================================================
# Node via fnm
# ============================================================

info "Installing fnm (Node version manager)..."
if ! check fnm; then
  if [[ "$PKG" == "brew" ]]; then
    brew install fnm
  else
    curl -fsSL https://fnm.vercel.app/install | bash -s -- --skip-shell
  fi
fi

# Set up fnm in current session
if command -v fnm &>/dev/null; then
  eval "$(fnm env)"
  if fnm list 2>/dev/null | grep -q "v"; then
    ok "  ✓ Node already installed via fnm ($(node --version 2>/dev/null || echo 'unknown'))"
  else
    info "  Installing latest LTS Node..."
    fnm install --lts
    fnm default lts-latest
  fi
fi

echo ""

# ============================================================
# Bun
# ============================================================

info "Installing Bun..."
if ! check bun; then
  curl -fsSL https://bun.sh/install | bash
fi

echo ""

# ============================================================
# WezTerm
# ============================================================

info "Installing WezTerm..."
if [[ "$OS" == "Darwin" ]]; then
  if [[ -d "/Applications/WezTerm.app" ]] || check wezterm; then
    ok "  ✓ WezTerm already installed"
  else
    brew install --cask wezterm
  fi
elif command -v flatpak &>/dev/null && flatpak info org.wezfurlong.wezterm &>/dev/null; then
  ok "  ✓ WezTerm already installed (flatpak)"
elif ! check wezterm; then
  # Flatpak first: works on every distro (incl. atomic ones) and adds a desktop entry
  if command -v flatpak &>/dev/null; then
    flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
    flatpak install --user -y flathub org.wezfurlong.wezterm
  else
    case "$PKG" in
      brew)
        brew tap wez/wezterm-linuxbrew
        brew install wezterm
        ;;
      apt)
        curl -fsSL https://apt.fury.io/wez/gpg.key | sudo gpg --yes --dearmor -o /usr/share/keyrings/wezterm-fury.gpg
        sudo chmod 644 /usr/share/keyrings/wezterm-fury.gpg
        echo 'deb [signed-by=/usr/share/keyrings/wezterm-fury.gpg] https://apt.fury.io/wez/ * *' | sudo tee /etc/apt/sources.list.d/wezterm.list >/dev/null
        sudo apt-get update -qq
        sudo apt-get install -y wezterm
        ;;
      dnf)
        sudo dnf copr enable -y wezfurlong/wezterm-nightly
        sudo dnf install -y wezterm
        ;;
      pacman)
        sudo pacman -S --noconfirm wezterm
        ;;
    esac
  fi
fi

# Geist Mono, the font config/wezterm.lua uses
if [[ "$OS" == "Darwin" ]]; then
  if [[ -f "$HOME/Library/Fonts/GeistMono-Regular.otf" ]] || brew list --cask font-geist-mono &>/dev/null; then
    ok "  ✓ Geist Mono already installed"
  else
    brew install --cask font-geist-mono
  fi
elif fc-list 2>/dev/null | grep -qi "Geist Mono"; then
  ok "  ✓ Geist Mono already installed"
elif ! command -v unzip &>/dev/null; then
  warn "  Install unzip, then rerun to get the Geist Mono font"
else
  GEIST_VERSION="$(curl -fsSL https://api.github.com/repos/vercel/geist-font/releases/latest | grep -m1 '"tag_name"' | sed -E 's/.*"([^"]+)".*/\1/')"
  GEIST_TMP="$(mktemp -d)"
  curl -fsSL -o "$GEIST_TMP/geist.zip" "https://github.com/vercel/geist-font/releases/download/$GEIST_VERSION/geist-font-$GEIST_VERSION.zip"
  mkdir -p "$HOME/.local/share/fonts/GeistMono"
  unzip -qjo "$GEIST_TMP/geist.zip" 'geist-font/GeistMono/otf/*' -d "$HOME/.local/share/fonts/GeistMono"
  rm -rf "$GEIST_TMP"
  fc-cache -f "$HOME/.local/share/fonts" >/dev/null
  ok "  ✓ Installed Geist Mono $GEIST_VERSION"
fi

echo ""

# ============================================================
# Handy (local speech-to-text dictation)
# ============================================================

info "Installing Handy..."
if [[ "$OS" == "Darwin" ]]; then
  if [[ -d "/Applications/Handy.app" ]]; then
    ok "  ✓ Handy already installed"
  else
    brew install --cask handy
  fi
elif [[ -x "$HOME/.local/bin/handy" ]]; then
  ok "  ✓ Handy already installed (AppImage)"
elif ! check handy; then
  # Not on Flathub, so install from the GitHub release assets
  HANDY_VERSION="$(curl -fsSL https://api.github.com/repos/cjpais/Handy/releases/latest | grep -m1 '"tag_name"' | sed -E 's/.*"v([^"]+)".*/\1/')"
  HANDY_URL="https://github.com/cjpais/Handy/releases/download/v$HANDY_VERSION"
  ARCH="$(uname -m)"
  case "$PKG" in
    apt)
      [[ "$ARCH" == "x86_64" ]] && DEB_ARCH="amd64" || DEB_ARCH="arm64"
      HANDY_DEB="$(mktemp --suffix=.deb)"
      curl -fsSL -o "$HANDY_DEB" "$HANDY_URL/Handy_${HANDY_VERSION}_${DEB_ARCH}.deb"
      chmod 644 "$HANDY_DEB"
      sudo apt-get install -y "$HANDY_DEB"
      rm -f "$HANDY_DEB"
      ;;
    dnf)
      sudo dnf install -y "$HANDY_URL/Handy-${HANDY_VERSION}-1.${ARCH}.rpm"
      ;;
    *)
      # brew (atomic distros, where dnf can't install) and pacman: AppImage + desktop entry
      [[ "$ARCH" == "x86_64" ]] && APPIMAGE_ARCH="amd64" || APPIMAGE_ARCH="aarch64"
      mkdir -p "$HOME/.local/bin" "$HOME/.local/share/applications"
      curl -fsSL -o "$HOME/.local/bin/handy" "$HANDY_URL/Handy_${HANDY_VERSION}_${APPIMAGE_ARCH}.AppImage"
      chmod +x "$HOME/.local/bin/handy"
      cat > "$HOME/.local/share/applications/handy.desktop" <<EOF
[Desktop Entry]
Name=Handy
Comment=Speech to text
Exec=$HOME/.local/bin/handy
Type=Application
Categories=Utility;
EOF
      ;;
  esac
fi

# Handy needs a text input tool on Linux to type into other apps
if [[ "$OS" == "Linux" ]]; then
  [[ "${XDG_SESSION_TYPE:-}" == "wayland" ]] && TYPE_TOOL="wtype" || TYPE_TOOL="xdotool"
  if ! check "$TYPE_TOOL"; then
    case "$PKG" in
      apt)    sudo apt-get install -y "$TYPE_TOOL" ;;
      dnf)    sudo dnf install -y "$TYPE_TOOL" ;;
      pacman) sudo pacman -S --noconfirm "$TYPE_TOOL" gtk-layer-shell ;;
      *)      warn "  Install $TYPE_TOOL with your system package manager so Handy can type text" ;;
    esac
  fi
fi

echo ""

# ============================================================
# macOS-only: trash
# ============================================================

if [[ "$OS" == "Darwin" ]]; then
  info "Installing macOS-only tools..."
  if ! check trash; then
    info "  Installing trash..."
    brew install trash
  fi
  echo ""
fi

# ============================================================
# Symlink config files
# ============================================================

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
CONFIG_DIR="$SCRIPT_DIR/config"

link_config() {
  local src="$1"
  local dest="$2"

  if [[ -L "$dest" ]]; then
    ok "  ✓ $dest already linked"
    return
  fi

  mkdir -p "$(dirname "$dest")"

  if [[ -f "$dest" ]]; then
    cp "$dest" "$dest.backup.$(date +%s)"
    warn "  Backed up existing $dest"
  fi

  ln -sf "$src" "$dest"
  info "  Linked $dest"
}

info "Linking config files..."

# Starship
link_config "$CONFIG_DIR/starship.toml" "$HOME/.config/starship.toml"

# Lazygit (config path differs by OS)
if [[ "$OS" == "Darwin" ]]; then
  link_config "$CONFIG_DIR/lazygit.yml" "$HOME/Library/Application Support/lazygit/config.yml"
else
  link_config "$CONFIG_DIR/lazygit.yml" "$HOME/.config/lazygit/config.yml"
fi

# WezTerm (same path on macOS and Linux, incl. flatpak)
link_config "$CONFIG_DIR/wezterm.lua" "$HOME/.config/wezterm/wezterm.lua"

# Claude Code — global rules plus the haup plugin from this repo's marketplace
if command -v claude &>/dev/null; then
  link_config "$CONFIG_DIR/claude/CLAUDE.md" "$HOME/.claude/CLAUDE.md"
  for rule in "$SCRIPT_DIR/plugins/haup/rules/"*.md; do
    link_config "$rule" "$HOME/.claude/rules/$(basename "$rule")"
  done

  if claude plugin marketplace list 2>/dev/null | grep -q "haup-term"; then
    claude plugin marketplace update haup-term >/dev/null 2>&1 || warn "  Could not update the haup-term marketplace"
  else
    claude plugin marketplace add "$SCRIPT_DIR" >/dev/null 2>&1 || warn "  Could not add the haup-term marketplace"
  fi

  if claude plugin list 2>/dev/null | grep -q "haup@haup-term"; then
    ok "  ✓ Claude plugin haup installed"
  elif claude plugin install "haup@haup-term" >/dev/null 2>&1; then
    info "  Installed Claude plugin haup"
  else
    warn "  Could not install Claude plugin haup"
  fi
fi

# Git — merge our config as an include so user.name/email are preserved
if ! git config --global --get include.path | grep -qF "$CONFIG_DIR/gitconfig" 2>/dev/null; then
  git config --global --add include.path "$CONFIG_DIR/gitconfig"
  info "  Added gitconfig as git include"
else
  ok "  ✓ gitconfig already included"
fi

# Prompt for git user if not set
if [[ -z "$(git config --global user.name 2>/dev/null)" ]]; then
  read -rp "  Git user.name: " git_name
  git config --global user.name "$git_name"
fi
if [[ -z "$(git config --global user.email 2>/dev/null)" ]]; then
  read -rp "  Git user.email: " git_email
  git config --global user.email "$git_email"
fi

echo ""

# ============================================================
# Configure shell rc file
# ============================================================

info "Configuring $SHELL_RC..."
echo ""

# Back up before modifying
if [[ -f "$SHELL_RC" ]]; then
  cp "$SHELL_RC" "$SHELL_RC.backup.$(date +%s)"
  ok "  ✓ Backed up $SHELL_RC"
fi

# fzf
rc_add '# fzf keybindings and fuzzy completion'
if [[ "$SHELL_NAME" == "zsh" ]]; then
  rc_add 'source <(fzf --zsh)'
elif [[ "$SHELL_NAME" == "bash" ]]; then
  rc_add 'eval "$(fzf --bash)"'
fi

# zoxide
rc_add '# zoxide (smart cd)'
rc_add 'eval "$(zoxide init '"$SHELL_NAME"')"'

# fnm
rc_add '# fnm (Node version manager)'
rc_add 'eval "$(fnm env --use-on-cd --shell '"$SHELL_NAME"')"'

# bun (its installer only writes to login-shell profiles on some systems)
rc_add '# bun'
rc_add 'export BUN_INSTALL="$HOME/.bun"'
rc_add 'export PATH="$BUN_INSTALL/bin:$PATH"'

# ccache (React Native iOS builds enable it via expo-build-properties; these settings
# apply even when React Native points CCACHE_CONFIGPATH at its own config)
# Xcode 26 no longer passes the CCACHE_BINARY build setting to the compiler, so React
# Native's ccache-clang.sh wrapper silently falls back to plain clang unless the variable
# comes from the shell environment.
rc_add '# ccache - shared compiler cache for native iOS builds'
rc_add 'export CCACHE_BINARY="$(command -v ccache)"'
rc_add 'export CCACHE_MAXSIZE=20G'
rc_add 'export CCACHE_BASEDIR="$HOME"'

# Starship (should be last)
rc_add 'eval "$(starship init '"$SHELL_NAME"')"'

echo ""
ok "Done! Open a new terminal or run: source $SHELL_RC"
