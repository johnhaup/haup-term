#!/bin/bash
# Sets up a fresh machine with dev tools and shell config.
# Supports macOS (Homebrew) and Linux (apt, dnf, pacman).
# Idempotent — safe to run multiple times, skips anything already installed.

set -euo pipefail

echo ""
echo '██╗  ██╗ █████╗ ██╗   ██╗██████╗        ████████╗███████╗██████╗ ███╗   ███╗'
echo '██║  ██║██╔══██╗██║   ██║██╔══██╗       ╚══██╔══╝██╔════╝██╔══██╗████╗ ████║'
echo '███████║███████║██║   ██║██████╔╝██████╗   ██║   █████╗  ██████╔╝██╔████╔██║'
echo '██╔══██║██╔══██║██║   ██║██╔═══╝ ╚═════╝   ██║   ██╔══╝  ██╔══██╗██║╚██╔╝██║'
echo '██║  ██║██║  ██║╚██████╔╝██║               ██║   ███████╗██║  ██║██║ ╚═╝ ██║'
echo '╚═╝  ╚═╝╚═╝  ╚═╝ ╚═════╝ ╚═╝               ╚═╝   ╚══════╝╚═╝  ╚═╝╚═╝     ╚═╝'
echo ""

# --- Pull latest changes ---
REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
if [[ -d "$REPO_DIR/.git" ]]; then
  echo "Pulling latest haup-term..."
  git -C "$REPO_DIR" pull --ff-only 2>/dev/null && echo "" || echo "  (could not pull — offline or uncommitted changes)"
fi

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

info()  { echo -e "${CYAN}$1${NC}"; }
ok()    { echo -e "${GREEN}$1${NC}"; }
warn()  { echo -e "${YELLOW}$1${NC}"; }
fail()  { echo -e "${RED}$1${NC}"; }

check() {
  if command -v "$1" &>/dev/null; then
    ok "  ✓ $1 already installed"
    return 0
  fi
  return 1
}

# --- Detect OS and package manager ---
OS="$(uname -s)"
DISTRO=""
PKG=""

case "$OS" in
  Darwin)
    PKG="brew"
    ;;
  Linux)
    if [[ -f /etc/os-release ]]; then
      DISTRO="$(. /etc/os-release && echo "$ID")"
    fi
    if command -v apt-get &>/dev/null; then
      PKG="apt"
    elif command -v dnf &>/dev/null; then
      PKG="dnf"
    elif command -v pacman &>/dev/null; then
      PKG="pacman"
    else
      fail "No supported package manager found (apt, dnf, pacman)."
      exit 1
    fi
    ;;
  *)
    fail "Unsupported OS: $OS"
    exit 1
    ;;
esac

# --- Detect shell rc file ---
if [[ -n "${ZSH_VERSION:-}" ]] || [[ "$SHELL" == */zsh ]]; then
  SHELL_RC="$HOME/.zshrc"
  SHELL_NAME="zsh"
elif [[ -n "${BASH_VERSION:-}" ]] || [[ "$SHELL" == */bash ]]; then
  SHELL_RC="$HOME/.bashrc"
  SHELL_NAME="bash"
else
  SHELL_RC="$HOME/.profile"
  SHELL_NAME="sh"
fi

# --- Helper: add a line to shell rc if not already present ---
rc_add() {
  local line="$1"
  if grep -qF "$line" "$SHELL_RC" 2>/dev/null; then
    ok "  ✓ $SHELL_RC already has: $line"
    return
  fi
  echo "$line" >> "$SHELL_RC"
  info "  Added to $SHELL_RC: $line"
}

# --- Helper: install a package ---
pkg_install() {
  local name="$1"
  # Some packages have different names across managers
  local brew_name="${2:-$name}"
  local apt_name="${3:-$name}"
  local dnf_name="${4:-$name}"
  local pacman_name="${5:-$name}"

  if check "$name"; then
    return
  fi

  info "  Installing $name..."
  case "$PKG" in
    brew)   brew install "$brew_name" ;;
    apt)    sudo apt-get install -y "$apt_name" ;;
    dnf)    sudo dnf install -y "$dnf_name" ;;
    pacman) sudo pacman -S --noconfirm "$pacman_name" ;;
  esac
}

echo -e "${CYAN}=== haup-term setup ($OS${DISTRO:+ / $DISTRO}) ===${NC}\n"

# ============================================================
# Package Manager
# ============================================================

if [[ "$OS" == "Darwin" ]]; then
  if ! check brew; then
    info "Installing Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    if [[ -f /opt/homebrew/bin/brew ]]; then
      eval "$(/opt/homebrew/bin/brew shellenv)"
    fi
  fi
elif [[ "$PKG" == "apt" ]]; then
  info "Updating apt package list..."
  sudo apt-get update -qq
fi

echo ""

# ============================================================
# CLI Tools
# ============================================================

info "Installing CLI tools..."

# Tools available in all package managers (with name overrides where needed)
#              command    brew        apt             dnf             pacman
pkg_install    "fzf"      "fzf"       "fzf"           "fzf"           "fzf"
pkg_install    "zoxide"   "zoxide"    "zoxide"        "zoxide"        "zoxide"
pkg_install    "lazygit"  "lazygit"   "lazygit"       "lazygit"       "lazygit"
pkg_install    "fd"       "fd"        "fd-find"       "fd-find"       "fd"
pkg_install    "bat"      "bat"       "bat"           "bat"           "bat"
pkg_install    "eza"      "eza"       "eza"           "eza"           "eza"
pkg_install    "yazi"     "yazi"      "yazi"          "yazi"          "yazi"
pkg_install    "htop"     "htop"      "htop"          "htop"          "htop"
pkg_install    "rg"       "ripgrep"   "ripgrep"       "ripgrep"       "ripgrep"
pkg_install    "jq"       "jq"        "jq"            "jq"            "jq"

echo ""

# ============================================================
# Posting (TUI API client)
# ============================================================

info "Installing Posting..."
if ! check posting; then
  if [[ "$PKG" == "brew" ]]; then
    brew install posting
  elif command -v pipx &>/dev/null; then
    pipx install posting
  elif command -v pip3 &>/dev/null; then
    pip3 install --user posting
  else
    warn "  Skipping posting — install pipx or pip3 first"
  fi
fi

echo ""

# ============================================================
# Starship prompt
# ============================================================

info "Installing Starship..."
if ! check starship; then
  if [[ "$PKG" == "brew" ]]; then
    brew install starship
  else
    curl -sS https://starship.rs/install.sh | sh -s -- -y
  fi
fi

echo ""

# ============================================================
# Node via fnm
# ============================================================

info "Installing fnm (Node version manager)..."
if ! check fnm; then
  if [[ "$PKG" == "brew" ]]; then
    brew install fnm
  else
    curl -fsSL https://fnm.vercel.app/install | bash -s -- --skip-shell
  fi
fi

# Set up fnm in current session
if command -v fnm &>/dev/null; then
  eval "$(fnm env)"
  if fnm list 2>/dev/null | grep -q "v"; then
    ok "  ✓ Node already installed via fnm ($(node --version 2>/dev/null || echo 'unknown'))"
  else
    info "  Installing latest LTS Node..."
    fnm install --lts
    fnm default lts-latest
  fi
fi

echo ""

# ============================================================
# Bun
# ============================================================

info "Installing Bun..."
if ! check bun; then
  curl -fsSL https://bun.sh/install | bash
fi

echo ""

# ============================================================
# macOS-only: rbenv + trash
# ============================================================

if [[ "$OS" == "Darwin" ]]; then
  info "Installing macOS-only tools..."
  if ! check rbenv; then
    info "  Installing rbenv..."
    brew install rbenv
  fi
  if ! check trash; then
    info "  Installing trash..."
    brew install trash
  fi
  echo ""
fi

# ============================================================
# Symlink config files
# ============================================================

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
CONFIG_DIR="$SCRIPT_DIR/config"

link_config() {
  local src="$1"
  local dest="$2"

  if [[ -L "$dest" ]]; then
    ok "  ✓ $dest already linked"
    return
  fi

  mkdir -p "$(dirname "$dest")"

  if [[ -f "$dest" ]]; then
    cp "$dest" "$dest.backup.$(date +%s)"
    warn "  Backed up existing $dest"
  fi

  ln -sf "$src" "$dest"
  info "  Linked $dest"
}

info "Linking config files..."

# Starship
link_config "$CONFIG_DIR/starship.toml" "$HOME/.config/starship.toml"

# Lazygit (config path differs by OS)
if [[ "$OS" == "Darwin" ]]; then
  link_config "$CONFIG_DIR/lazygit.yml" "$HOME/Library/Application Support/lazygit/config.yml"
else
  link_config "$CONFIG_DIR/lazygit.yml" "$HOME/.config/lazygit/config.yml"
fi

# Git — merge our config as an include so user.name/email are preserved
if ! git config --global --get include.path | grep -qF "$CONFIG_DIR/gitconfig" 2>/dev/null; then
  git config --global --add include.path "$CONFIG_DIR/gitconfig"
  info "  Added gitconfig as git include"
else
  ok "  ✓ gitconfig already included"
fi

# Prompt for git user if not set
if [[ -z "$(git config --global user.name 2>/dev/null)" ]]; then
  read -rp "  Git user.name: " git_name
  git config --global user.name "$git_name"
fi
if [[ -z "$(git config --global user.email 2>/dev/null)" ]]; then
  read -rp "  Git user.email: " git_email
  git config --global user.email "$git_email"
fi

echo ""

# ============================================================
# Configure shell rc file
# ============================================================

info "Configuring $SHELL_RC..."
echo ""

# Back up before modifying
if [[ -f "$SHELL_RC" ]]; then
  cp "$SHELL_RC" "$SHELL_RC.backup.$(date +%s)"
  ok "  ✓ Backed up $SHELL_RC"
fi

# fzf
rc_add '# fzf keybindings and fuzzy completion'
if [[ "$SHELL_NAME" == "zsh" ]]; then
  rc_add 'source <(fzf --zsh)'
elif [[ "$SHELL_NAME" == "bash" ]]; then
  rc_add 'eval "$(fzf --bash)"'
fi

# zoxide
rc_add '# zoxide (smart cd)'
rc_add 'eval "$(zoxide init '"$SHELL_NAME"')"'

# fnm
rc_add '# fnm (Node version manager)'
rc_add 'eval "$(fnm env --use-on-cd --shell '"$SHELL_NAME"')"'

# rbenv (macOS only)
if [[ "$OS" == "Darwin" ]]; then
  rc_add '# rbenv'
  rc_add 'eval "$(rbenv init - '"$SHELL_NAME"')"'
fi

# Starship (should be last)
rc_add 'eval "$(starship init '"$SHELL_NAME"')"'

echo ""
ok "Done! Open a new terminal or run: source $SHELL_RC"
